{
    "name": "jund-fauz/eloquent-kompact",
    "description": "A set of automation & helper tools to improve development experience and convenience in building app using Eloquent ORM by Laravel",
    "type": "library",
    "keywords": [
        "laravel",
        "eloquent",
        "model",
        "fillable",
        "casts",
        "auto-cast",
        "relations",
        "naming-convention",
        "query-builder",
        "raw-query"
    ],
    "homepage": "https://github.com/jund-fauz/eloquent-kompact",
    "support": {
        "issues": "https://github.com/jund-fauz/eloquent-kompact/issues",
        "source": "https://github.com/jund-fauz/eloquent-kompact"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "JundFauz\\EloquentKompact\\": "src/"
        },
        "files": [
            "src/Helper/Array.php",
            "src/Helper/Concatenation.php",
            "src/Helper/Constant.php",
            "src/Helper/Etc.php",
            "src/Helper/String.php",
            "src/Helper/Logic/Comparison/Basic.php",
            "src/Helper/Logic/Comparison/Main.php",
            "src/Helper/Logic/Comparison/Type.php",
            "src/Helper/Logic/Math.php",
            "src/Helper/Logic/Negation.php",
            "src/Helper/File/Concatenation.php",
            "src/Helper/File/ExtensionAdding.php",
            "src/Helper/File/IO.php",
            "src/Helper/File/Z-ConstantExtension.php",
            "src/Column/Payload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "JundFauz\\EloquentKompact\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "jund-fauz"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "symfony/polyfill-php84": "^1.43",
        "laravel/framework": "^12.0|^13.0",
        "ext-bcmath": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "orchestra/testbench": "^11.3"
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JundFauz\\EloquentKompact\\EloquentKompactServiceProvider"
            ]
        }
    }
}
